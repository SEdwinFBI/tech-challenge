# Docker Compose
MSSQL_SA_PASSWORD=
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ANONYMOUS_ENABLED=false
WEB_PORT=8080
WEB_BIND=0.0.0.0
TRUST_PROXY=1
MSSQL_PORT=1433
PROMETHEUS_PORT=9090
GRAFANA_PORT=3002

# API
PORT=3000
NODE_ENV=development
CORS_ALLOW_ORIGIN=http://localhost:8080
RESERVATION_TTL_MINUTES=15

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=ShopCartDB
DB_ENCRYPT=false

# JWT
JWT_ACCESS_SECRET=cambiar
JWT_REFRESH_SECRET=cambiar
JWT_ACCESS_EXPIRES_IN_MIN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_FAMILY_EXPIRES_IN_DAYS=30

# Limite de intentos de autenticacion
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MIN=15

#Nota: no es necesario tener las claves para que el proyecto funcione
#extras añadidos

# IA para recomendacines y busqueda con JEV
#modelo para clasificacion de desiciones
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
JEV_URL=

# Imagenes S3 y CDN
#Almacenamiento de objetos en Amazon S3 y distribucion de contenido a traves de CDN
S3_BUCKET=
S3_REGION=
CDN_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
