PORT=3000

# Entorno: development, production o test
NODE_ENV=development

# SQL Server 2019+
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=ShopCartDB

# JWT
JWT_ACCESS_SECRET=access_token_super_secret_key_change_in_production
JWT_REFRESH_SECRET=refresh_token_super_secret_key_change_in_production
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7
JWT_FAMILY_EXPIRES_IN=30

# Rate limit de autenticación
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MS=15

# Origen CORS del frontend
CORS_ALLOW_ORIGIN=http://localhost:5173
