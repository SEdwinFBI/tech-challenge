# API
PORT=3000
NODE_ENV=development
CORS_ALLOW_ORIGIN=http://localhost:5173
TRUST_PROXY=
RESERVATION_TTL_MINUTES=15

# SQL Server
DB_HOST=localhost
DB_PORT=1433
DB_USER=sa
DB_PASSWORD=
DB_NAME=ShopCartDB
DB_ENCRYPT=false

# JWT
JWT_ACCESS_SECRET=access_token_______________
JWT_REFRESH_SECRET=refresh_token_______________
JWT_ACCESS_EXPIRES_IN_MIN=15m
JWT_REFRESH_EXPIRES_IN_DAYS=7
JWT_FAMILY_EXPIRES_IN_DAYS=30

# Límite de intentos de autenticación
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_AUTH_WINDOW_MIN=15

# IA para recomendaciones y búsqueda con JEV
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
JEV_TIMEOUT_MS=2000
JEV_URL=

# Imágenes S3 y CDN
S3_BUCKET=
S3_REGION=
CDN_BASE_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Redis y varias réplicas
REDIS_URL=
INSTANCE_ID=
